---
import Layout from '../layouts/Layout.astro';
import { site, stats, socials, projects } from '../data/site';

const selectedWorks = projects.slice(0, 4);
---

<Layout
  title="Giacomo Tornello | Freelance Marketing, Project Management, Scrum Master & Web"
  description="Freelance digitale in Sicilia: marketing, gestione di team e progetti, QA. App e siti web. Scopri come posso aiutarti a crescere online."
>
  <!-- HERO -->
  <section class="hero">
    <p class="hero-based">Based in {site.location}</p>
    <h1 class="hero-title">
      Ciao, sono {site.firstName} <span class="hero-emoji">:)</span>
      <span class="hero-role">{site.role.split('·')[1]?.trim() || 'Freelance Digitale'}</span>
    </h1>
    <p class="hero-sub">
      Creo esperienze digitali moderne attraverso strategia, creatività e visione
      pulita — trasformando idee in risultati concreti.
    </p>
    <ul class="hero-socials">
      {socials.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
        </li>
      ))}
    </ul>
    <div class="hero-visual">
      <div class="hero-photo-placeholder">
        <span>Foto<br />in arrivo</span>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about">
    <h2 class="section-title">Chi sono</h2>
    <p class="about-text">{site.bio}</p>
    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
    <a class="btn" href="/about">Scopri di più</a>
  </section>

  <!-- SELECTED WORKS -->
  <section class="works">
    <h2 class="section-title">Progetti<br />selezionati</h2>
    <div class="works-grid">
      {selectedWorks.map((w) => (
        <a class="work-card" href={w.url} target="_blank" rel="noopener">
          <div class="work-browser-dot" aria-hidden="true" />
          <h3 class="work-title">{w.title}</h3>
          <p class="work-desc">{w.description}</p>
          <span class="work-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <a class="btn btn-outline" href="/works">Tutti i progetti</a>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <h2 class="cta-title">
      Hai un progetto<br />in mente?
    </h2>
    <a class="btn btn-accent" href="/contact">Get in touch</a>
  </section>
</Layout>

<style>
  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    text-align: center;
  }

  .hero-based {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
  }

  .hero-emoji {
    color: var(--accent);
  }

  .hero-role {
    color: var(--muted);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .hero-sub {
    max-width: 560px;
    margin: 1.5rem auto 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .hero-socials {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .hero-socials a {
    color: var(--muted);
    font-weight: 500;
  }

  .hero-socials a:hover {
    color: var(--fg);
  }

  .hero-visual {
    margin-top: 3rem;
  }

  .hero-photo-placeholder {
    aspect-ratio: 16 / 9;
    max-width: 640px;
    margin: 0 auto;
    background: linear-gradient(135deg, #efe9df, #e3dccd);
    border-radius: var(--radius);
    border: var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 1.1rem;
    text-align: center;
    line-height: 1.4;
  }

  .about,
  .works,
  .cta-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .about-text {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .stats {
    display: flex;
    gap: 3rem;
    margin: 2.5rem 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .btn {
    display: inline-block;
    background: var(--fg);
    color: var(--bg);
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .btn-outline {
    background: transparent;
    color: var(--fg);
    border: var(--border);
  }

  .btn-accent {
    background: var(--accent);
    color: #17150f;
  }

  .btn:hover {
    opacity: 0.85;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .work-card {
    position: relative;
    border: var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(23, 21, 15, 0.08);
  }

  .work-browser-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }

  .work-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .work-desc {
    color: var(--muted);
    font-size: 0.9rem;
    flex-grow: 1;
  }

  .work-arrow {
    font-size: 1.3rem;
  }

  .cta-section {
    text-align: center;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }
</style>
