---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Licenze | Giacomo Tornello"
  description="Licenze e attribuzioni del sito di Giacomo Tornello."
>
  <section class="licenses">
    <h1 class="page-title">Licenze</h1>
    <p>
      Questo sito è basato sul tema <strong>Michael — Portfolio Theme for Designers</strong>
      (Astro), di cui è mantenuta l'attribuzione originale.
    </p>
    <p>
      I contenuti, i testi e i progetti presentati sono di proprietà di
      {site.name}.
    </p>
  </section>
</Layout>

<style>
  .licenses {
    max-width: 720px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .licenses p {
    color: var(--muted);
    margin-bottom: 1rem;
    line-height: 1.7;
  }
</style>
