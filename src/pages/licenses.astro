---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Licenze | Giacomo Tornello"
  description="Licenze e attribuzioni del sito di Giacomo Tornello."
>
  <section class="licenses-page">
    <div class="container licenses-page__content">
      <header class="licenses-page__header">
        <p class="licenses-page__eyebrow">Attribuzioni</p>
        <h1>Licenze</h1>
        <p>
          Questo sito è basato sul tema <strong>Michael — Portfolio Theme for
          Designers</strong> (Astro), di cui è mantenuta l'attribuzione originale.
          I contenuti, i testi e i progetti presentati sono di proprietà di
          {site.name}.
        </p>
      </header>
    </div>
  </section>
</Layout>

<style>
  .licenses-page {
    padding: 2rem 0 clamp(6rem, 10vw, 10rem);
  }
  .licenses-page__content {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .licenses-page__header {
    max-width: 44rem;
  }
  .licenses-page__eyebrow {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    margin: 0 0 1.5rem;
  }
  .licenses-page h1 {
    color: #fff;
    letter-spacing: -0.055em;
    margin: 0;
    font-size: 6.3rem;
    line-height: 0.94;
  }
  .licenses-page__header > p:last-child {
    max-width: 38rem;
    color: var(--color-muted);
    margin: 2.5rem 0 0;
    font-size: 1.25rem;
    line-height: 1.5;
  }
  @media (max-width: 560px) {
    .licenses-page h1 {
      font-size: 3.4rem;
    }
  }
</style>
