---
import Layout from '../layouts/Layout.astro';
import { site, projects } from '../data/site';
---

<Layout
  title="Progetti | Giacomo Tornello"
  description="Portfolio progetti di Giacomo Tornello: sviluppo web WordPress, QA, Scrum Master, SEO/SEM e marketing digitale per aziende e startup."
>
  <section class="works-hero">
    <span class="works-period">(2019 — oggi)</span>
    <h1 class="works-title">
      Progetti<br />in evidenza
    </h1>
    <p class="works-sub">
      Una selezione di progetti reali su cui ho lavorato tra sviluppo web,
      coordinamento Agile, QA, SEO/SEM e marketing digitale.
    </p>
  </section>

  <section class="works">
    <div class="works-grid">
      {projects.map((w) => (
        <a class="work-card" href={w.url} target="_blank" rel="noopener">
          <div class="work-browser-dot" aria-hidden="true" />
          <h3 class="work-title">{w.title}</h3>
          <p class="work-desc">{w.description}</p>
          <span class="work-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <h2 class="cta-title">
      Lavoriamo<br />insieme?
    </h2>
    <a class="btn btn-accent" href="/contact">Get in touch</a>
  </section>
</Layout>

<style>
  .works-hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    text-align: center;
  }

  .works-period {
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .works-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-top: 0.5rem;
  }

  .works-sub {
    max-width: 560px;
    margin: 1.25rem auto 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .works {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .work-card {
    border: var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(23, 21, 15, 0.08);
  }

  .work-browser-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
  }

  .work-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .work-desc {
    color: var(--muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .work-arrow {
    font-size: 1.4rem;
  }

  .cta-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .btn-accent {
    background: var(--accent);
    color: #17150f;
  }
</style>
