---
import Layout from '../layouts/Layout.astro';
import { site, projects } from '../data/site';
---

<Layout
  title="Progetti | Giacomo Tornello"
  description="Portfolio progetti di Giacomo Tornello: sviluppo web WordPress, QA, Scrum Master, SEO/SEM e marketing digitale per aziende e startup."
>
  <section class="works-directory" aria-labelledby="works-title">
    <div class="container works-directory__content">
      <header class="works-directory__header">
        <p class="works-directory__period"><span>(</span>2019 — oggi<span>)</span></p>
        <h1 id="works-title">Progetti<br />in <strong>evidenza</strong></h1>
        <p>
          Una selezione di progetti reali su cui ho lavorato tra sviluppo web,
          coordinamento Agile, QA, SEO/SEM e marketing digitale.
        </p>
      </header>

      <div class="works-directory__grid">
        {projects.map((w, i) => {
          const colors = ['#D4EF6D', '#7772FF', '#FFA59C', '#EABA2B'];
          return (
            <a class="works__card" href={w.url} target="_blank" rel="noopener" aria-label={`Vedi progetto ${w.title}`}>
              <div class="works__browser">
                <div class="works__project-media" aria-hidden="true">
                  <div class="works__project-image" style={`background: linear-gradient(135deg, ${colors[i % 4]}33, #0c1212);`}></div>
                </div>
                <span class="works__project-name">{w.title}</span>
                <span class="works__project-arrow" aria-hidden="true">→</span>
              </div>
              <p class="works__desc">{w.description}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-heading">
    <div class="container cta__inner">
      <p class="cta__eyebrow"><span>Hai un progetto in mente?</span></p>
      <h2 class="cta__headline" id="cta-heading">
        <span class="cta__line cta__line--top">Lavoriamo</span>
        <span class="cta__line cta__line--bottom">insieme</span>
      </h2>
      <a class="cta__button" href="/contact">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .works-directory {
    padding: 2rem 0 clamp(5rem, 9vw, 9rem);
  }
  .works-directory__content {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .works-directory__header {
    max-width: 44rem;
  }
  .works-directory__period {
    color: #fff;
    font-size: 1.35rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.01em;
    margin: 0 0 1.5rem;
    line-height: 1;
  }
  .works-directory__period span {
    color: var(--color-accent-lime);
  }
  .works-directory__header h1 {
    color: #fff;
    font-size: 6.3rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.055em;
    margin: 0;
    line-height: 0.94;
  }
  .works-directory__header h1 strong {
    color: var(--color-accent-purple);
    font: inherit;
  }
  .works-directory__header > p:last-child {
    max-width: 38rem;
    color: var(--color-muted);
    margin: 2rem 0 0;
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .works-directory__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem) clamp(2rem, 4vw, 4rem);
    margin-top: clamp(4rem, 8vw, 7rem);
    display: grid;
  }

  .works__card {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .works__browser {
    isolation: isolate;
    aspect-ratio: 410 / 350;
    width: 100%;
    position: relative;
    background: #111;
    border-radius: 2.5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .works__project-media {
    z-index: 2;
    position: absolute;
    inset: 8%;
    border-radius: 1.25rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .works__project-image {
    position: absolute;
    inset: 0;
  }
  .works__project-name {
    z-index: 3;
    background: var(--color-accent-lime);
    color: #0c1212;
    min-width: 5rem;
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    border-radius: 999px;
    justify-content: center;
    align-items: center;
    padding: 0.55rem 1.1rem;
    line-height: 1;
    display: inline-flex;
    position: absolute;
    top: 12%;
    left: 6%;
  }
  .works__project-arrow {
    z-index: 3;
    aspect-ratio: 1;
    background: var(--color-accent-purple);
    border: 1.5px solid #fff;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    width: clamp(3.35rem, 11.8%, 4.65rem);
    font-size: 1.5rem;
    color: #fff;
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    position: absolute;
    bottom: 6%;
    right: 5%;
  }
  .works__desc {
    color: var(--color-muted);
    margin: 1rem 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 38rem;
  }
  .works__card:hover .works__project-arrow {
    transform: rotate(8deg) scale(1.05);
  }

  /* ===== CTA ===== */
  .cta {
    isolation: isolate;
    align-items: center;
    min-height: 60vh;
    padding: clamp(6rem, 9vw, 9rem) 0;
    display: flex;
    position: relative;
  }
  .cta__inner {
    text-align: center;
    flex-direction: column;
    align-items: center;
    display: flex;
    position: relative;
  }
  .cta__eyebrow {
    color: var(--color-muted);
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.2;
    display: inline-flex;
  }
  .cta__headline {
    isolation: isolate;
    color: #fff;
    width: min(100%, 70rem);
    font-size: 7rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.065em;
    margin: clamp(3rem, 5vw, 5rem) 0 0;
    line-height: 0.86;
    position: relative;
  }
  .cta__line {
    white-space: nowrap;
    justify-content: center;
    align-items: center;
    display: flex;
    position: relative;
  }
  .cta__line--bottom {
    margin-top: 0.28em;
    color: var(--color-accent-purple);
  }
  .cta__button {
    z-index: 5;
    border: 1.5px solid var(--color-accent-lime);
    background: var(--color-accent-lime);
    color: var(--color-bg);
    font-size: 0.95rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-radius: 999px;
    justify-content: center;
    align-items: center;
    margin-top: clamp(3.5rem, 5vw, 5rem);
    padding: 1.35rem 3.2rem;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.22s, color 0.22s, transform 0.22s;
    display: inline-flex;
    position: relative;
  }
  .cta__button:hover {
    color: var(--color-accent-lime);
    background: 0 0;
    transform: rotate(-4deg);
  }

  @media (max-width: 600px) {
    .works-directory__header h1 {
      font-size: 2.7rem;
    }
    .works-directory__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .cta__headline {
      font-size: 3.5rem;
    }
  }
</style>
