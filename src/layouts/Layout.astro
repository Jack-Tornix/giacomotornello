---
import { site, socials } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title.includes('Giacomo Tornello')
  ? title
  : `${title} | Giacomo Tornello`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="freelance marketing digitale, project manager agile, sviluppo siti web WordPress, QA tester, Scrum Master, formazione marketing digitale"
    />
    <link rel="canonical" href={Astro.url} />
    <meta name="author" content={site.name} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Font: Albert Sans (reference Michael Theme) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"></div>
    <main>
      <header class="site-header">
        <nav class="site-header__bar container" aria-label="Navigazione principale">
          <a class="site-header__logo" href="/" aria-label="Giacomo Tornello home">
            <span class="site-header__logo-track">
              <span class="site-header__logo-text">{site.name}©</span>
              <span class="site-header__logo-text site-header__logo-text--accent" aria-hidden="true">{site.name}©</span>
            </span>
          </a>
          <a class="site-header__cta" href="/contact">Get in touch</a>
        </nav>

        <slot />
      </header>

      <footer class="site-footer">
        <div class="site-footer__card">
          <div class="site-footer__main">
            <div class="site-footer__info">
              <a class="site-footer__brand site-footer__slide-link" href="/" aria-label="Giacomo Tornello home">
                <span class="site-footer__link-clip">
                  <span class="site-footer__link-track">
                    <span class="site-footer__link-text">{site.name}©</span>
                    <span class="site-footer__link-text site-footer__link-text--accent" aria-hidden="true">{site.name}©</span>
                  </span>
                </span>
              </a>
              <p class="site-footer__description">
                <span>{site.tagline}</span>
                <span class="site-footer__description-symbol" aria-hidden="true">㋡</span>
              </p>
              <a class="site-footer__email site-footer__slide-link" href={`mailto:${site.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m4.5 7 7.5 6 7.5-6"></path></svg>
                <span class="site-footer__link-clip">
                  <span class="site-footer__link-track">
                    <span class="site-footer__link-text">{site.email}</span>
                    <span class="site-footer__link-text site-footer__link-text--accent" aria-hidden="true">{site.email}</span>
                  </span>
                </span>
              </a>
              <ul class="site-footer__socials" aria-label="Social media">
                {socials.map((s) => (
                  <li>
                    <a href={s.url} target="_blank" rel="noreferrer" aria-label={s.label}>
                      <span class="site-footer__social-clip">
                        <span class="site-footer__social-track">
                          <span class="site-footer__social-icon">{s.label}</span>
                          <span class="site-footer__social-icon site-footer__social-icon--accent" aria-hidden="true">{s.label}</span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <nav class="site-footer__pages" aria-label="Pagine">
              <h2>Pagine</h2>
              <ul>
                <li><a class="site-footer__slide-link" href="/"><span class="site-footer__link-clip"><span class="site-footer__link-track"><span class="site-footer__link-text">Home</span><span class="site-footer__link-text site-footer__link-text--accent" aria-hidden="true">Home</span></span></span></a></li>
                <li><a class="site-footer__slide-link" href="/about"><span class="site-footer__link-clip"><span class="site-footer__link-track"><span class="site-footer__link-text">Chi sono</span><span class="site-footer__link-text site-footer__link-text--accent" aria-hidden="true">Chi sono</span></span></span></a></li>
                <li><a class="site-footer__slide-link" href="/works"><span class="site-footer__link-clip"><span class="site-footer__link-track"><span class="site-footer__link-text">Progetti</span><span class="site-footer__link-text site-footer__link-text--accent" aria-hidden="true">Progetti</span></span></span></a></li>
                <li><a class="site-footer__slide-link" href="/contact"><span class="site-footer__link-clip"><span class="site-footer__link-track"><span class="site-footer__link-text">Contatti</span><span class="site-footer__link-text site-footer__link-text--accent" aria-hidden="true">Contatti</span></span></span></a></li>
                <li><a class="site-footer__slide-link" href="/licenses"><span class="site-footer__link-clip"><span class="site-footer__link-track"><span class="site-footer__link-text">Licenze</span><span class="site-footer__link-text site-footer__link-text--accent" aria-hidden="true">Licenze</span></span></span></a></li>
              </ul>
            </nav>

            <a class="site-footer__cta" href="/contact">Parliamone</a>
          </div>
          <div class="site-footer__bottom">
            <p>{site.name}© <span aria-hidden="true">—</span> Tutti i diritti riservati</p>
            <p>Freelance digitale · Sicilia</p>
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #0c1212;
    --color-fg: #e8edec;
    --color-muted: #a3a3a3;
    --color-accent-purple: #7772ff;
    --color-accent-lime: #d4f06d;
    --color-accent-pink: #ff9e9e;
    --color-accent-yellow: #eaba2b;
    --font-sans: "Albert Sans", system-ui, sans-serif;
    --font-weight-regular: 400;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --container-max: 1440px;
    --container-pad-x: clamp(1.25rem, 4vw, 3.5rem);
  }

  *,
  :before,
  :after {
    box-sizing: border-box;
  }

  html,
  body {
    background-color: var(--color-bg);
    min-height: 100%;
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-regular);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    margin: 0;
  }

  body {
    min-height: 100vh;
    position: relative;
  }

  .page-bg {
    z-index: 0;
    pointer-events: none;
    opacity: 0.02;
    background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px);
    background-size: 64px 64px;
    width: 100%;
    height: 100vh;
    position: fixed;
    inset: 0 auto auto 0;
  }

  main {
    z-index: 1;
    min-height: 100vh;
    position: relative;
  }

  .container {
    width: 100%;
    max-width: var(--container-max);
    padding-inline: var(--container-pad-x);
    margin-inline: auto;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-semibold);
  }

  p {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-regular);
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>
