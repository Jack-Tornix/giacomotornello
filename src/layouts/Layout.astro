---
import { site, socials } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title.includes('Giacomo Tornello')
  ? title
  : `${title} | Giacomo Tornello`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="freelance marketing digitale, project manager agile, sviluppo siti web WordPress, QA tester, Scrum Master, formazione marketing digitale"
    />
    <link rel="canonical" href={Astro.url} />
    <meta name="author" content={site.name} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">{site.name}</a>
      <nav class="main-nav" aria-label="Navigazione principale">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/works">Works</a>
        <a href="/contact">Contact</a>
      </nav>
      <a class="cta-nav" href="/contact">Get in touch</a>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-top">
        <a href="/" class="logo">{site.name}</a>
        <p class="footer-tagline">{site.tagline}</p>
        <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <div class="footer-socials" aria-label="Social">
        {socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
      </div>

      <nav class="footer-pages" aria-label="Pagine">
        <span class="footer-label">Pagine</span>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/works">Works</a>
        <a href="/contact">Contact</a>
        <a href="/licenses">Licenze</a>
      </nav>

      <a class="footer-cta" href="/contact">Let's Talk</a>

      <div class="footer-bottom">
        <span>{site.name} © — Tutti i diritti riservati</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #faf7f2;
    --fg: #17150f;
    --muted: #6b6659;
    --accent: #ff5c35;
    --accent-2: #c7ff3c;
    --radius: 18px;
    --border: 1px solid rgba(23, 21, 15, 0.1);
    --font-body: 'Inter', 'Helvetica Neue', system-ui, sans-serif;
    --font-display: 'Clash Display', 'Inter', system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .main-nav {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }

  .main-nav a {
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.2s;
  }

  .main-nav a:hover {
    color: var(--fg);
  }

  .cta-nav {
    background: var(--fg);
    color: var(--bg);
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform 0.2s, opacity 0.2s;
  }

  .cta-nav:hover {
    opacity: 0.85;
  }

  .site-footer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    border-top: var(--border);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr auto;
    gap: 2rem;
    align-items: start;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-tagline {
    color: var(--muted);
    max-width: 340px;
  }

  .footer-email {
    text-decoration: underline;
    font-weight: 500;
  }

  .footer-socials {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-socials a:hover {
    opacity: 0.7;
  }

  .footer-pages {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-label {
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .footer-pages a {
    color: var(--muted);
  }

  .footer-pages a:hover {
    color: var(--fg);
  }

  .footer-cta {
    background: var(--accent);
    color: #17150f;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .footer-bottom {
    grid-column: 1 / -1;
    padding-top: 2rem;
    border-top: var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .site-header {
      flex-wrap: wrap;
      gap: 1rem;
    }
    .main-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      margin-left: 0;
    }
    .site-footer {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
